# Copy to backend/.env and adjust as needed. Every variable here has a
# sane default in app/config.py / utils/live_weather.py -- none of this
# is required to run the app locally.

# ---- CORS ----
# Comma-separated list of allowed origins. "*" is fine for local dev.
CORS_ORIGINS=http://localhost:3000

# ---- Caching ----
PREDICTION_CACHE_TTL_SECONDS=3600
RECOMMENDATION_CACHE_TTL_SECONDS=3600
WEATHER_ML_CACHE_TTL_SECONDS=3600
# Leave unset to use the built-in in-memory cache. Set to use Redis instead
# (requires `pip install redis`, see requirements.txt).
# REDIS_URL=redis://localhost:6379/0

# ---- Rate limiting ----
# 120 is fine once the frontend cache (see frontend/src/api/client.ts) is
# in place. If you're actively developing with multiple tabs/StrictMode
# double-firing effects, bump this to 300-500 locally.
RATE_LIMIT_PER_MINUTE=120

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Live weather (utils/live_weather.py -- powers /weather/live) ----
# Defaults to Open-Meteo, which needs no API key. Only set these if you
# want to switch to OpenWeatherMap instead.
# WEATHER_PROVIDER=openweathermap
# OPENWEATHERMAP_API_KEY=
WEATHER_TIMEOUT_SECONDS=4.0
