# TourIntel — Live Weather Layer — Environment Variables
#
# The CURRENT provider (Open-Meteo, https://open-meteo.com/en/docs) needs NO API key
# for prototype use. This file only matters if/when you switch WEATHER_PROVIDER to
# a key-based provider (e.g. OpenWeather) in tourintel_weather/live_weather.py.
#
# Copy this file to `.env` and fill in real values — never commit `.env` itself.

# Required only if WEATHER_PROVIDER = "openweather" (not implemented yet, stub only)
OPENWEATHER_API_KEY=

# Optional: cache TTL override (minutes). Defaults to 12 if unset.
WEATHER_CACHE_TTL_MINUTES=12
